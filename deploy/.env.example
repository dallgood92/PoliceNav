# Use a real DNS hostname pointed to the EC2 Elastic IP.
DOMAIN=api.example.com

# Generate each secret independently with: openssl rand -hex 32
# Hex-only passwords are safe inside the connection URLs used by Compose.
POSTGRES_PASSWORD=replace-with-random-hex
REDIS_PASSWORD=replace-with-random-hex
LOCATION_API_TOKEN=replace-with-random-hex
OWNER_USER_ID=device-mttltae8-j90p7ae7
DEPARTMENT_JOIN_CODE=replace-with-a-private-department-code

MOVEMENT_ALERT_METERS=152.4
ALERT_COOLDOWN_MS=60000
